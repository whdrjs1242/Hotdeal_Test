# ---- 필수 ----
DATABASE_URL=postgres://postgres@localhost:5432/hotdeal
# 세션 서명 키 (openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
# 서비스 공개 URL (공유 링크/OG 이미지에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 선택: 캐시/카운터 (미설정 시 인메모리) ----
REDIS_URL=redis://localhost:6379

# ---- 제휴 (설정된 네트워크만 수익화, 나머지는 원본 링크) ----
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
LINKPRICE_AFFILIATE_ID=
ALIEXPRESS_AFF_SHORT_KEY=
AMAZON_ASSOCIATE_TAG=

# ---- 로그인 ----
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 개발용 닉네임 로그인 허용 (운영에서는 반드시 false)
ALLOW_DEV_LOGIN=true

# ---- 웹 푸시 (npx web-push generate-vapid-keys) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- 운영 ----
# 크론 엔드포인트 보호용 토큰
CRON_SECRET=change-me
# 관리자 사용자 id (쉼표 구분)
ADMIN_USER_IDS=

# ---- 포인트 ----
# 가입 축하 포인트 / 현금화 비율(1P 당 원) / 최소 현금화 포인트
SIGNUP_BONUS_POINTS=1000
CASHOUT_RATE=1
CASHOUT_MIN_POINTS=10000
# 카카오톡 공유 (JavaScript 키)
NEXT_PUBLIC_KAKAO_JS_KEY=
